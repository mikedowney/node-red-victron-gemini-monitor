    {
        "id": "bd9d2bb2e3a2b750",
        "type": "function",
        "z": "571d1030f6c6a086",
        "name": "Format Alert Email",
        "func": "const reportText = msg.payload.candidates[0].content.parts[0].text;\nconst formattedReport = reportText.replace(/\\n/g, '<br>');\nconst htmlFooter = `\n    <br><br><hr>\n    <p>View live system dashboard here: <a href=\"https://vrm.victronenergy.com/installations/YOUR_INSTALLATION_ID/dashboard\" target=\"_blank\">Open VRM Portal</a></p>\n`;\nreturn {\n    topic: \"⚠️ Power System Engineering Alert\",\n    payload: reportText + \"\\n\\n--- \\nView VRM: https://vrm.victronenergy.com/installations/YOUR_INSTALLATION_ID/dashboard\",\n    html: formattedReport + htmlFooter\n};",
