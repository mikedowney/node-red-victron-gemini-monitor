    {
        "id": "747cdac55b51c710",
        "type": "function",
        "z": "571d1030f6c6a086",
        "name": "Build Comprehensive Prompt",
        "func": "const diagnosticsData = flow.get(\"diagnostics\") || {};\nconst statsData = flow.get(\"stats\") || {};\nconst alarmsData = msg.payload || {};\n\nconst now = new Date();\nconst currentDateTimeStr = now.toLocaleString('en-US', { timeZone: 'America/Los_Angeles', weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short' });\n\nconst systemPrompt = `You are the chief engineer and safety officer on a marine vessel. Analyze the following bundled multi-source Victron operational logs for any anomalies or safety related issues.\n\nReporting Rules:\n- Current Time Anchor: The current system time is ${currentDateTimeStr}.\n- CRITICAL: If all current parameters are operating within normal system tolerances, do NOT write any sections, breakdowns, summaries, or introductory text. You must output the single word NOMINAL and absolutely nothing else.\n\n=========================================\nDATASET 1: diagnostics.json\n=========================================\n${JSON.stringify(diagnosticsData)}\n\n=========================================\nDATASET 2: stats.json (24-Hour Time Series Trends)\n=========================================\n${JSON.stringify(statsData)}\n\n=========================================\nDATASET 3: alarms.json (Configured Alarm Settings)\n=========================================\n${JSON.stringify(alarmsData)}`;\n\nmsg.url = \"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=YOUR_API_KEY_HERE\";\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\nmsg.payload = {\n    \"contents\": [{\n        \"parts\": [{\n            \"text\": systemPrompt\n        }]\n    }]\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
